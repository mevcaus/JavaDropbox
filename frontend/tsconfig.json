{
  // Type-checks the app (npm run typecheck); Vite and Vitest compile it on their own and only
  // strip the types, so this is what catches type errors. Everything in src is TypeScript, so a
  // JavaScript file there is refused rather than imported unchecked.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    // Every file is a module of its own, even one with no import or export, so two files can't
    // clash over a top-level name.
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
